; Engine configuration file.
; Pinned to Godot 4.6.3 (see .github/workflows/ci.yml).

config_version=5

[application]

config/name="Highway 1"
config/description="Iowa Highway 1, Kalona to Iowa City. Chaos encouraged."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[audio]

driver/output_latency.web=100
general/default_playback_type.web=0

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Settings="*res://scripts/autoload/settings.gd"
Leaderboard="*res://scripts/autoload/leaderboard.gd"
Touch="*res://scripts/autoload/touch.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[highway]

leaderboard_url=""

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="car"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false

[shader_globals]

sun_shadow_scale={
"type": "float",
"value": 0.0
}
sky_light_drawn={
"type": "vec3",
"value": Vector3(0.35, 0.35, 0.33)
}
sky_light_full={
"type": "vec3",
"value": Vector3(0.35, 0.35, 0.33)
}
haze_color={
"type": "vec3",
"value": Vector3(0.5, 0.6, 0.7)
}
haze_range={
"type": "vec2",
"value": Vector2(450, 3000)
}
sky_sheen={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ground_detail={
"type": "float",
"value": 1.0
}
